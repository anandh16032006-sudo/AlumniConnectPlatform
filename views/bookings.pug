extends layout
block content
  .page-header
    h1.page-title
      i.fas.fa-handshake
      span  Mentorship Bookings
    p.page-sub Track all your mentorship requests and connections

  .bookings-page
    .bookings-info
      .info-card
        i.fas.fa-graduation-cap
        div
          h4 Students
          p View and track your mentorship requests
      .info-card
        i.fas.fa-chalkboard-teacher
        div
          h4 Alumni
          p Review and respond to mentorship requests
      .info-card
        i.fas.fa-shield-alt
        div
          h4 Admins
          p View all platform mentorship activity

    .bookings-actions
      a.btn-primary(href="/alumni")
        i.fas.fa-search
        span  Find a Mentor

    .bookings-list#mentorshipBookings
      .loading-shimmer
      .loading-shimmer
